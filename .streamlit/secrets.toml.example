# Nothing here is required. The app is bring-your-own-key: each visitor pastes
# their own Anthropic API key on the page, and the app never reads a key from this file.
#
# Copy this file to .streamlit/secrets.toml (it is git-ignored) only if you want one of these.
# On Streamlit Community Cloud, paste the same lines into the app's Secrets box instead.

# Optional: require a password before the app opens.
# APP_PASSWORD = "pick-a-password"

# Optional: signs the offer messages.
# BUYER_NAME = "Mani"
